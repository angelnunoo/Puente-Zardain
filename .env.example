# ===========================================
# VARIABLES DE ENTORNO - PUENTE DE ZARDAIN
# ===========================================

# Base de Datos
DATABASE_URL="postgresql://username:password@localhost:5432/puente_zardain"
DATABASE_HOST="localhost"
DATABASE_PORT=5432
DATABASE_USER="puente_zardain"
DATABASE_PASSWORD="your_secure_password"
DATABASE_NAME="puente_zardain"

# JWT
JWT_SECRET="your_jwt_secret_key_minimum_32_characters"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Stripe (Pagos)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"

# PayPal (Pagos)
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id"

# Bizum (Pagos)
BIZUM_MERCHANT_ID="your_bizum_merchant_id"
BIZUM_SECRET_KEY="your_bizum_secret_key"

# Redis (Cache y Sesiones)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="your_redis_password"

# URL de la Aplicación
FRONTEND_URL="https://puente-zardain.es"
BACKEND_URL="https://api.puente-zardain.es"
API_BASE_URL="https://api.puente-zardain.es"

# Entorno
NODE_ENV="production"
PORT=3001

# Correo Electrónico
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="contacto@puente-zardain.es"
EMAIL_PASS="your_email_password"
EMAIL_FROM="Puente de Zardain <contacto@puente-zardain.es>"

# Monitorización
LOG_LEVEL="info"
SENTRY_DSN="your_sentry_dsn_for_error_tracking"

# Almacenamiento (AWS S3 o similar)
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_REGION="eu-west-1"
AWS_S3_BUCKET="puente-zardain-uploads"

# Seguridad
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN="https://puente-zardain.es"

# Backups
BACKUP_SCHEDULE="0 2 * * *"  # Todos los días a las 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY="your_backup_encryption_key"

# Analytics y Tracking
GOOGLE_ANALYTICS_ID="GA-MEASUREMENT_ID"
HOTJAR_ID="your_hotjar_id"

# Configuración del Restaurante
RESTAURANT_NAME="Puente de Zardain"
RESTAURANT_EMAIL="contacto@puente-zardain.es"
RESTAURANT_PHONE="+34 900 123 456"
RESTAURANT_ADDRESS="Calle Principal 123, 28001 Madrid, España"

# Límites de Operación
MAX_ORDERS_PER_HOUR=50
MAX_ORDER_AMOUNT=500
MIN_ORDER_AMOUNT=5

# Mantenimiento
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="El sistema está en mantenimiento. Volveremos pronto."
